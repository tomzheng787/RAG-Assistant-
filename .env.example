# Copy this file to .env, then uncomment and fill in the keys for the providers you use.
# Leave unused keys commented out: an empty ANTHROPIC_API_KEY would override an `ant auth login` profile.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# ZHIPUAI_API_KEY=
# SILICONFLOW_API_KEY=
# GEMINI_API_KEY=
# VOYAGE_API_KEY=
# Only for a Milvus server with authentication or Zilliz Cloud:
# MILVUS_TOKEN=
